# Copie este arquivo para ".env" (na mesma pasta backend/) e preencha com as
# credenciais reais. O ".env" nunca deve ser versionado (já está no .gitignore).
DATABASE_URL_CORE=postgresql://usuario:senha@host:5432/core_db
DATABASE_URL_LOJAS=postgresql://usuario:senha@host:5432/lojas_db
DATABASE_URL_LISTA=postgresql://usuario:senha@host:5432/lista_de_lojas_db
DATABASE_URL_ESIGMA=postgresql://usuario:senha@host:5432/esigma

# Opcional: só necessário para rodar scripts pontuais de migração de dados
# legados (ex.: seed_lojas.py). Pode ficar em branco no dia a dia.
DATABASE_URL_LEGACY_REF=postgresql://usuario:senha@host:5432/esigma_db_ref

# URL base da API do e-Sigma (usada para validar o usuário autenticado).
ESIGMA_API_BASE_URL=https://e-sigma.app/api/v1
ESIGMA_VALIDATE_TIMEOUT_SEGUNDOS=5

# Nunca "true" em produção — só para testes locais sem um e-Sigma rodando.
COREVM_PERMITIR_BYPASS_DEV=false
