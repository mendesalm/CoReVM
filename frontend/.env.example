# EM CONFORMIDADE COM AS REGRAS DE OURO DO E-SIGMA
# Copie este arquivo para .env e ajuste os valores para o seu ambiente.

# URL base da API do próprio backend do CoReVM (porta 8003 em desenvolvimento).
VITE_API_URL=http://localhost:8003/api/v1

# URL base da API do e-Sigma (IdP central do ecossistema) — usada pela tela
# de login (PaginaLogin.tsx) para autenticar de verdade via POST /auth/login
# e POST /auth/google, antes de guardar o JWT real emitido pelo e-Sigma.
# ALTERAÇÃO (2026-09-11): variável nova, criada junto com a implementação do
# login real do CoReVM (antes a tela de login era inteiramente mock e não
# fazia nenhuma chamada de rede).
VITE_ESIGMA_API_URL=http://localhost:8001/api/v1

# Client ID do Google OAuth usado pelo botão "Continuar com o Google" nesta
# tela e pelo GoogleOAuthProvider em main.tsx.
VITE_GOOGLE_CLIENT_ID=
